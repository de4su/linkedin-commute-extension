{
  "manifest_version": 3,
  "name": "LinkedIn Commute Time",
  "version": "1.0.0",
  "description": "Shows commute time from your home to each job on LinkedIn's job search page.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://maps.googleapis.com/*", "https://api.geoapify.com/*", "https://9292.nl/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Commute Time settings"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content_script.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    }
  ]
}
